// Replace the previous Rally match block INSIDE
// match /databases/{database}/documents in project gestaltgesetze-ada34.
// Keep existing quiz rules unchanged. This is not an entire rules file.
// One shared game: FreeCreatures controls rally_games/current without a login.
match /rally_games/{gameId} {
  function validRally() {
    let data = request.resource.data;
    return data.keys().hasAll(['version', 'roundId', 'creatureNames', 'digits', 'energy', 'foundIds', 'releasedIds', 'homeIds', 'updatedAt'])
      && data.keys().hasOnly(['version', 'roundId', 'creatureNames', 'digits', 'energy', 'foundIds', 'releasedIds', 'homeIds', 'updatedAt'])
      && data.version == 1
      && data.roundId is string && data.roundId.matches('^[a-f0-9]{32}$')
      && data.creatureNames == ['Corphish', 'Fuecoco', 'Shiny Feraligatr', 'Charizard', 'White Kyurem', 'Shiny Chien-Pao', 'Toxel', 'Iron Moth']
      && data.digits == ['4', '7', '2', '9', '5', '1', '8', '3']
      && data.energy is int && data.energy >= 0 && data.energy <= 100
      && data.foundIds is list && data.foundIds.size() <= 9 && data.foundIds.hasOnly([1,2,3,4,5,6,7,8,9])
      && data.releasedIds is list && data.releasedIds.size() <= 8 && data.releasedIds.hasOnly([1,2,3,4,5,6,7,8])
      && data.homeIds is list && data.homeIds.size() <= 8 && data.homeIds.hasOnly(data.releasedIds)
      && data.updatedAt == request.time;
  }
  function freshRound() {
    return request.resource.data.energy == 100
      && request.resource.data.foundIds.size() == 0
      && request.resource.data.releasedIds.size() == 0
      && request.resource.data.homeIds.size() == 0;
  }
  allow get: if gameId == 'current';
  allow create: if gameId == 'current' && validRally() && freshRound();
  allow update: if gameId == 'current' && validRally() && (
    (request.resource.data.roundId != resource.data.roundId && freshRound())
    || (request.resource.data.roundId == resource.data.roundId
      && request.resource.data.foundIds.hasAll(resource.data.foundIds)
      && request.resource.data.releasedIds.hasAll(resource.data.releasedIds)
      && request.resource.data.homeIds.hasAll(resource.data.homeIds))
  );
}
