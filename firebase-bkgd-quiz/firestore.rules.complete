rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Bestehende Quiz-Regeln
    match /{document=**} {
      allow read, write: if request.time < timestamp.date(2026, 8, 7);
    }

    // Rally / FreeCreatures
    // Eine gemeinsame Rally wird unter rally_games/current gespeichert.
    match /rally_games/{gameId} {

      function validRally() {
        let data = request.resource.data;

        return data.keys().hasAll([
          'version',
          'roundId',
          'creatureNames',
          'digits',
          'energy',
          'foundIds',
          'releasedIds',
          'homeIds',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'version',
          'roundId',
          'creatureNames',
          'digits',
          'energy',
          'foundIds',
          'releasedIds',
          'homeIds',
          'updatedAt'
        ])
        && data.version == 1
        && data.roundId is string
        && data.roundId.matches('^[a-f0-9]{32}$')

        && data.creatureNames == [
          'Corphish',
          'Fuecoco',
          'Shiny Feraligatr',
          'Charizard',
          'White Kyurem',
          'Shiny Chien-Pao',
          'Toxel',
          'Iron Moth'
        ]

        && data.digits == [
          '4',
          '7',
          '2',
          '9',
          '5',
          '1',
          '8',
          '3'
        ]

        && data.energy is int
        && data.energy >= 0
        && data.energy <= 100

        && data.foundIds is list
        && data.foundIds.size() <= 9
        && data.foundIds.hasOnly([1,2,3,4,5,6,7,8,9])

        && data.releasedIds is list
        && data.releasedIds.size() <= 8
        && data.releasedIds.hasOnly([1,2,3,4,5,6,7,8])

        && data.homeIds is list
        && data.homeIds.size() <= 8
        && data.homeIds.hasOnly(data.releasedIds)

        && data.updatedAt == request.time;
      }

      function freshRound() {
        return request.resource.data.energy == 100
          && request.resource.data.foundIds.size() == 0
          && request.resource.data.releasedIds.size() == 0
          && request.resource.data.homeIds.size() == 0;
      }

      allow get: if gameId == 'current';

      allow create: if gameId == 'current'
        && validRally()
        && freshRound();

      allow update: if gameId == 'current'
        && validRally()
        && (
          (
            request.resource.data.roundId != resource.data.roundId
            && freshRound()
          )
          ||
          (
            request.resource.data.roundId == resource.data.roundId
            && request.resource.data.foundIds.hasAll(resource.data.foundIds)
            && request.resource.data.releasedIds.hasAll(resource.data.releasedIds)
            && request.resource.data.homeIds.hasAll(resource.data.homeIds)
          )
        );
    }


    // BKGD Quiz – Zeitsynchronisation
    match /bkgd_quiz_clocks/{uid} {

      allow get: if request.auth != null
        && request.auth.uid == uid;

      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['time'])
        && request.resource.data.time == request.time;
    }


    // BKGD Quiz – Spiele
    match /bkgd_quiz_games/{pin} {

      function signedIn() {
        return request.auth != null;
      }

      function owner() {
        return signedIn()
          && resource.data.ownerUid == request.auth.uid;
      }

      function validGame() {
        let d = request.resource.data;

        return d.keys().hasAll([
          'ownerUid',
          'version',
          'phase',
          'questionIndex',
          'startedAt',
          'createdAt',
          'updatedAt'
        ])
        && d.keys().hasOnly([
          'ownerUid',
          'version',
          'phase',
          'questionIndex',
          'startedAt',
          'createdAt',
          'updatedAt'
        ])
        && d.ownerUid is string
        && d.version == 1
        && d.phase in [
          'lobby',
          'question',
          'reveal',
          'finished'
        ]
        && d.questionIndex is int
        && d.questionIndex >= -1
        && d.questionIndex < 20
        && d.createdAt is timestamp
        && d.updatedAt == request.time;
      }

      allow get: if signedIn();

      allow create: if signedIn()
        && pin.matches('^[0-9]{6}$')
        && validGame()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.phase == 'lobby'
        && request.resource.data.questionIndex == -1
        && request.resource.data.startedAt == null
        && request.resource.data.createdAt == request.time;

      allow update: if owner()
        && validGame()
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt
        && (
          (
            resource.data.phase in ['lobby', 'reveal']
            && resource.data.questionIndex < 19
            && request.resource.data.phase == 'question'
            && request.resource.data.questionIndex == resource.data.questionIndex + 1
            && request.resource.data.startedAt == request.time
          )
          ||
          (
            resource.data.phase == 'question'
            && request.resource.data.phase == 'reveal'
            && request.resource.data.questionIndex == resource.data.questionIndex
            && request.resource.data.startedAt == resource.data.startedAt
            && request.time >= resource.data.startedAt + duration.value(30, 's')
          )
          ||
          (
            resource.data.phase == 'reveal'
            && resource.data.questionIndex == 19
            && request.resource.data.phase == 'finished'
            && request.resource.data.questionIndex == 19
            && request.resource.data.startedAt == resource.data.startedAt
          )
        );


      // Spieler
      match /players/{uid} {

        function game() {
          return get(
            /databases/$(database)/documents/bkgd_quiz_games/$(pin)
          ).data;
        }

        allow read: if request.auth != null;

        allow create: if request.auth != null
          && request.auth.uid == uid
          && game().phase == 'lobby'
          && request.resource.data.keys().hasAll([
            'name',
            'joinedAt'
          ])
          && request.resource.data.keys().hasOnly([
            'name',
            'joinedAt'
          ])
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 2
          && request.resource.data.name.size() <= 20
          && request.resource.data.name.matches('.*[^ ].*')
          && request.resource.data.joinedAt == request.time;
      }


      // Antworten
      match /answers/{answerId} {

        function game() {
          return get(
            /databases/$(database)/documents/bkgd_quiz_games/$(pin)
          ).data;
        }

        allow get: if request.auth != null
          && (
            game().ownerUid == request.auth.uid
            || game().phase == 'finished'
            || answerId.matches(
              '^[0-9]+_' + request.auth.uid + '$'
            )
          );

        allow list: if request.auth != null
          && (
            game().ownerUid == request.auth.uid
            || game().phase == 'finished'
          );

        allow create: if request.auth != null
          && exists(
            /databases/$(database)/documents/bkgd_quiz_games/$(pin)/players/$(request.auth.uid)
          )

          // NEU: questionStartedAt
          && request.resource.data.keys().hasAll([
            'uid',
            'questionIndex',
            'choice',
            'questionStartedAt',
            'answeredAt'
          ])

          && request.resource.data.keys().hasOnly([
            'uid',
            'questionIndex',
            'choice',
            'questionStartedAt',
            'answeredAt'
          ])

          && request.resource.data.uid == request.auth.uid

          && request.resource.data.questionIndex is int
          && request.resource.data.questionIndex == game().questionIndex

          && answerId == string(request.resource.data.questionIndex)
            + '_'
            + request.auth.uid

          && request.resource.data.choice is int
          && request.resource.data.choice >= 0
          && request.resource.data.choice <= 3

          // NEU: Antwort muss zur aktuell laufenden Frage gehören
          && request.resource.data.questionStartedAt == game().startedAt

          && request.resource.data.answeredAt == request.time

          && game().phase == 'question'
          && request.time >= game().startedAt
          && request.time < game().startedAt + duration.value(30, 's');
      }
    }

    // Design-Thinking: Beiträge und moderierte Ergebnisse
    // Add inside match /databases/{database}/documents. Preserve other rules.
    function designTeacher() {
      return request.auth != null
        && exists(/databases/$(database)/documents/design_thinking_admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/design_thinking_admins/$(request.auth.uid)).data.enabled == true;
    }
    match /design_thinking_admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    match /design_thinking_posts/{postId} {
      allow read: if true;
      allow update: if designTeacher()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 5000;
      allow delete: if designTeacher();
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['uid', 'kind', 'text', 'createdAt'])
        && request.resource.data.keys().hasOnly(['uid', 'kind', 'text', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.kind in ['briefing', 'problem']
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 5000
        && request.resource.data.createdAt == request.time;
    }
    match /design_thinking_results/{resultId} {
      allow get: if request.auth != null && resultId == 'current';
      allow create, update: if designTeacher() && resultId == 'current'
        && request.resource.data.keys().hasAll(['rebriefing', 'problem', 'sourceIds', 'updatedBy', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['rebriefing', 'problem', 'sourceIds', 'updatedBy', 'updatedAt'])
        && request.resource.data.rebriefing is string && request.resource.data.rebriefing.size() <= 20000
        && request.resource.data.problem is string && request.resource.data.problem.size() <= 20000
        && request.resource.data.sourceIds is list && request.resource.data.sourceIds.size() <= 500
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
    }

    match /design_thinking_votes/{uid} {
      function problem(id) {
        return id is string
          && exists(/databases/$(database)/documents/design_thinking_posts/$(id))
          && get(/databases/$(database)/documents/design_thinking_posts/$(id)).data.kind == 'problem';
      }
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasAll(['postIds', 'createdAt'])
        && request.resource.data.keys().hasOnly(['postIds', 'createdAt'])
        && request.resource.data.postIds is list
        && request.resource.data.postIds.size() >= 1
        && request.resource.data.postIds.size() <= 2
        && request.resource.data.postIds.toSet().size() == request.resource.data.postIds.size()
        && problem(request.resource.data.postIds[0])
        && (request.resource.data.postIds.size() == 1 || problem(request.resource.data.postIds[1]))
        && request.resource.data.createdAt == request.time;
    }
  }
}
