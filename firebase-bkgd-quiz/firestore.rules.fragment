// Add INSIDE match /databases/{database}/documents in gestaltgesetze-ada34.
// Keep the existing Gestaltgesetze, Rally and other rules unchanged.
// Requires Firebase Authentication > Sign-in method > Anonymous enabled.
match /bkgd_quiz_clocks/{uid} {
  allow get: if request.auth != null && request.auth.uid == uid;
  allow create, update: if request.auth != null && request.auth.uid == uid
    && request.resource.data.keys().hasOnly(['time'])
    && request.resource.data.time == request.time;
}
match /bkgd_quiz_games/{pin} {
  function signedIn() { return request.auth != null; }
  function owner() { return signedIn() && resource.data.ownerUid == request.auth.uid; }
  function validGame() {
    let d = request.resource.data;
    return d.keys().hasAll(['ownerUid', 'version', 'phase', 'questionIndex', 'startedAt', 'createdAt', 'updatedAt'])
      && d.keys().hasOnly(['ownerUid', 'version', 'phase', 'questionIndex', 'startedAt', 'createdAt', 'updatedAt'])
      && d.ownerUid is string && d.version == 1
      && d.phase in ['lobby', 'question', 'reveal', 'finished']
      && d.questionIndex is int && d.questionIndex >= -1 && d.questionIndex < 20
      && d.createdAt is timestamp && d.updatedAt == request.time;
  }
  allow get: if signedIn();
  allow create: if signedIn() && pin.matches('^[0-9]{6}$') && validGame()
    && request.resource.data.ownerUid == request.auth.uid
    && request.resource.data.phase == 'lobby' && request.resource.data.questionIndex == -1
    && request.resource.data.startedAt == null && request.resource.data.createdAt == request.time;
  allow update: if owner() && validGame()
    && request.resource.data.ownerUid == resource.data.ownerUid
    && request.resource.data.createdAt == resource.data.createdAt
    && (
      (resource.data.phase in ['lobby', 'reveal'] && resource.data.questionIndex < 19
        && request.resource.data.phase == 'question'
        && request.resource.data.questionIndex == resource.data.questionIndex + 1
        && request.resource.data.startedAt == request.time)
      || (resource.data.phase == 'question' && request.resource.data.phase == 'reveal'
        && request.resource.data.questionIndex == resource.data.questionIndex
        && request.resource.data.startedAt == resource.data.startedAt
        && request.time >= resource.data.startedAt + duration.value(30, 's'))
      || (resource.data.phase == 'reveal' && resource.data.questionIndex == 19
        && request.resource.data.phase == 'finished' && request.resource.data.questionIndex == 19
        && request.resource.data.startedAt == resource.data.startedAt)
    );
  match /players/{uid} {
    function game() { return get(/databases/$(database)/documents/bkgd_quiz_games/$(pin)).data; }
    allow read: if request.auth != null;
    allow create: if request.auth != null && request.auth.uid == uid && game().phase == 'lobby'
      && request.resource.data.keys().hasAll(['name', 'joinedAt'])
      && request.resource.data.keys().hasOnly(['name', 'joinedAt'])
      && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 20
      && request.resource.data.name.matches('.*[^ ].*')
      && request.resource.data.joinedAt == request.time;
  }
  match /answers/{answerId} {
    function game() { return get(/databases/$(database)/documents/bkgd_quiz_games/$(pin)).data; }
    allow get: if request.auth != null && (
      game().ownerUid == request.auth.uid || game().phase == 'finished'
      || answerId.matches('^[0-9]+_' + request.auth.uid + '$')
    );
    allow list: if request.auth != null && (game().ownerUid == request.auth.uid || game().phase == 'finished');
    allow create: if request.auth != null
      && exists(/databases/$(database)/documents/bkgd_quiz_games/$(pin)/players/$(request.auth.uid))
      && request.resource.data.keys().hasAll(['uid', 'questionIndex', 'choice', 'questionStartedAt', 'answeredAt'])
      && request.resource.data.keys().hasOnly(['uid', 'questionIndex', 'choice', 'questionStartedAt', 'answeredAt'])
      && request.resource.data.uid == request.auth.uid
      && request.resource.data.questionIndex is int
      && request.resource.data.questionIndex == game().questionIndex
      && answerId == string(request.resource.data.questionIndex) + '_' + request.auth.uid
      && request.resource.data.choice is int && request.resource.data.choice >= 0 && request.resource.data.choice <= 3
      && request.resource.data.questionStartedAt == game().startedAt
      && request.resource.data.answeredAt == request.time
      && game().phase == 'question'
      && request.time >= game().startedAt
      && request.time < game().startedAt + duration.value(30, 's');
  }
}
